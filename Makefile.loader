# AURA.CC CS2 Enterprise Loader Makefile
# Compiles C++ SaaS Loader .exe with Embedded .dll payload

CXX = x86_64-w64-mingw32-g++
CXXFLAGS = -std=c++20 -O3 -Iinclude -D_WIN32_WINNT=0x0A00
LDFLAGS = -static -lws2_32 -lpsapi -ladvapi32

TARGET = bin/AuraLoader.exe
SRC = src/loader/loader_main.cpp src/loader/loader_core.cpp

all: directories $(TARGET)

directories:
	mkdir -p bin

$(TARGET): $(SRC)
	@echo "[*] Compiling AURA.CC Enterprise SaaS Loader (.exe)..."
	$(CXX) $(CXXFLAGS) $(SRC) -o $(TARGET) $(LDFLAGS)
	@echo "[+] Build complete: $(TARGET)"

clean:
	rm -rf bin
